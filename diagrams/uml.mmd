classDiagram
  class Owner {
    -name: string
    -age: int
    -pets: List~Pet~
    -scheduler: Scheduler
    +addPet(Pet pet) void
    +removePet(Pet pet) void
  }

  class Pet {
    -name: string
    -age: int
    -petType: string
    -tasks: List~Task~
  }

  class Task {
    -date: int
    -type: string
    -priority: int
    -name: string
    -completed: bool
    +mark_complete() void
  }

  class Scheduler {
    +GenerateSchedule(long date, string pet_name)
    +AddTask(string pet_name, long date, string type, int priority, string name) bool
    +RemoveTask(string pet_name, string name) bool
    +EditTask(string pet_name, string name, long date, int priority) bool
  }

  Person --> "0..*" Pet : has pets
  Person --> "0..*" Task : has tasks
  Person --> "0..*" Scheduler : has scheduler

  note for Person "AddTask checks this person's tasks by name.\nIf the name already exists, return false without adding.\nOtherwise, add the task and return true.\nRemoveTask removes the task matching the name.\nReturn true if removed, or false if not found.\nEditTask finds a task by name and updates its duration and priority.\nReturn true if updated, or false if not found."