classDiagram
  class Owner {
    -name: string
    -age: int
    -pets: List~Pet~
    -scheduler: Scheduler
    +addPet(Pet pet) bool
    +removePet(Pet pet) bool
  }

  class Pet {
    -name: string
    -age: int
    -petType: string
    -tasks: List~Task~
  }

  class Task {
    -date: int
    -type: string
    -priority: int
    -name: string
    -completed: bool
    +mark_complete() void
  }

  class Scheduler {
    +GenerateSchedule(long date, string pet_name)
    +AddTask(string pet_name, long date, string type, int priority, string name) bool
    +RemoveTask(string pet_name, string name) bool
    +EditTask(string pet_name, string name, long date, int priority) bool
    +UpdateCompletedTask(List~Task~, long date) void
    +GetPetTasks(string pet_name) List~Task~
  }

  Owner --> "0..*" Pet : has pets
  Owner --> "0..*" Task : has tasks
  Owner --> "0..*" Scheduler : has scheduler